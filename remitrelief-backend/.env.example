PORT=4000
NODE_ENV=development

# Explicit demo financial mutations (forced OFF when NODE_ENV=production)
DEMO_MODE=true

# Stellar network — TESTNET | FUTURENET | STANDALONE (mainnet disabled)
STELLAR_NETWORK=TESTNET
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet

# Funded testnet account used to simulate reads and sign release() calls.
# Create + fund via https://friendbot.stellar.org — NEVER use a mainnet secret.
# Never expose this to the frontend / VITE_* vars.
BACKEND_SIGNER_SECRET=

# Protects privileged standalone release calls (header: x-internal-api-key).
# Required for non-demo POST /milestones/:id/release.
INTERNAL_API_KEY=

# Optional: wire the Oaxaca seed campaign to a deployed escrow contract ID
DEMO_ESCROW_CONTRACT_ID=

# Dev-only store wipe endpoint
ALLOW_STORE_RESET=false

LOG_LEVEL=info
