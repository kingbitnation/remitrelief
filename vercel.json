{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && cd remitrelief-frontend && npm install",
  "buildCommand": "cd remitrelief-frontend && npm run build",
  "outputDirectory": "remitrelief-frontend/dist",
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/stats", "destination": "/api" },
    { "source": "/campaigns", "destination": "/api" },
    { "source": "/campaigns/:path*", "destination": "/api" },
    { "source": "/donations", "destination": "/api" },
    { "source": "/donations/:path*", "destination": "/api" },
    { "source": "/milestones", "destination": "/api" },
    { "source": "/milestones/:path*", "destination": "/api" },
    { "source": "/ledger", "destination": "/api" },
    { "source": "/ledger/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "remitrelief-backend/**"
    }
  }
}
